{
  "dxt_version": "0.1",
  "name": "mail-dxt",
  "version": "1.0.0",
  "description": "Sichere Mail.app-Steuerung für Claude Desktop – nur fest definierte Funktionen, kein freies AppleScript.",
  "long_description": "Erlaubt Claude Desktop, die macOS Mail.app sicher zu steuern: Mails lesen, suchen, Entwürfe erstellen und Mails verschieben. Kein direktes Senden, keine permanente Löschung, kein Shell-Zugriff.",
  "author": {
    "name": "David",
    "url": "https://github.com/MAP089"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "MAIL_DXT_OSASCRIPT_TIMEOUT_MS": "120000",
        "MAIL_DXT_APPLESCRIPT_TIMEOUT_S": "100",
        "MAIL_DXT_DEBUG": "1"
      }
    }
  },
  "tools": [
    { "name": "mail_list_accounts", "description": "Alle Mail-Konten auflisten" },
    { "name": "mail_list_mailboxes", "description": "Mailboxen eines Kontos auflisten" },
    { "name": "mail_search", "description": "Mails in einer Mailbox suchen" },
    { "name": "mail_read", "description": "Eine Mail lesen" },
    { "name": "mail_compose_draft", "description": "Entwurf erstellen (kein automatisches Senden)" },
    { "name": "mail_move", "description": "Mail in eine andere Mailbox verschieben" },
    { "name": "mail_delete_to_trash", "description": "Mail in den Papierkorb verschieben" }
  ],
  "keywords": ["mcp", "mail", "applescript", "macos"],
  "license": "MIT"
}
